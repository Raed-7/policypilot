# Generation backend: auto | groq | gemini | ollama | extractive
# "auto" uses Groq or Gemini when a key is set, otherwise the extractive answerer.
LLM_PROVIDER=auto

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_STRATEGY=fixed
CHUNK_SIZE=256
CHUNK_OVERLAP=64
TOP_K=5
SCORE_THRESHOLD=0.2
EVIDENCE_THRESHOLD=0.56
RETRIEVAL_MODE=hybrid

CHROMA_DIR=data/chroma
SEED_SAMPLE_DOCS=true
